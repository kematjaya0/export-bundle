{
    "name": "kematjaya/export-bundle",
    "type": "library",
    "license": "MIT",
    "description": "help to export various format output",
    "authors": [
        {
            "name": "Nur Hidayatullah",
            "email": "kematjaya0@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "kematjaya/export": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/config": "^6.4",
        "symfony/twig-bundle": "^6.4",
        "symfony/framework-bundle": "^6.4",
        "symfony/yaml": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/phpunit-bridge": "^6.4",
        "symfony/var-dumper": "^6.4",
        "symfony/browser-kit": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "Kematjaya\\ExportBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kematjaya\\ExportBundle\\Tests\\": "tests/"
        }
    }
}
